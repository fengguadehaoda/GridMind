# ============================================================
# GridMind 项目根 .gitignore（M0 阶段追加 docker-data/）
# ============================================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments
venv/
.venv/
env/
ENV/

# IDE
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Environment files (保留 .env.example)
.env
.env.local
.env.*.local

# Logs
logs/
*.log

# Data — sqlite 数据库
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm
data/chroma/
# D9：实际持久化目录是 data/chroma_db/（含 chroma.sqlite3，约 188KB）
data/chroma_db/
data/uploads/

# ===== M0 阶段新增（知识图谱 Neo4j 升级）=====
# Neo4j 容器数据卷（docker-data/ 整个目录忽略，包含 Neo4j 持久化数据）
docker-data/

# ===== 前端 Node/Vite =====
# Node.js 依赖（157MB，必须忽略）
web/node_modules/
web/pnpm-lock.yaml
# Vite 构建产物
web/dist/
web/dist-*/
# 遗留 A4/B3：下划线变体构建备份（如 dist_qa_backup_*）与 QA 打包产物
web/dist_*/
web/qa_*.mjs
web/qa_*.ts
web/qa_shots/
# Vite 配置文件运行时临时产物（dev server 热更新生成的 timestamp 文件）
web/vite.config.ts.timestamp-*.mjs
# 前端 QA 临时产物（截图/结果/临时脚本/测试输出）
web/qa-*/
web/qa-*.mjs
web/qa-*.json
web/qa-shots/
web/test-results/
web/tmp/
web/.qa-*.mjs
web/src/.vite/
# Vue 缓存
.web-vite/

# ===== 根目录 QA 临时产物（P0/P1 迭代遗留，不纳入基线）=====
/qa_*.txt
/qa_*.log
/qa_*.py
/pytest_out.log
/vue_tsc_*.log
/npm_build_*.log
/qa_matrix_out.log
/graph_diff.txt
/import_err*.txt
/import_exit*.txt
/route_verify*.txt

# ===== 基准测试结果（每次 pytest 自动更新，避免提交后 dirty）=====
benchmarks/results/

# ===== WorkBuddy 工作区 =====
# WorkBuddy workspace memory（项目级 .workbuddy/）
.workbuddy/

# ===== 调试截图（避免 commit 历史噪音，按需保留）=====
# 解开注释可保留；默认忽略
# *.png
# *.jpg
# *.jpeg

# ===== IDE 额外 =====
*.iml
*.iws
.history/

# 构建产物/临时目录（发布忽略）
dist.*
qa-tmp-cleanup/
