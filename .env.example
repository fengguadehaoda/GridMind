# GridMind 环境配置
# 复制此文件为 .env 并填入真实值
# D8：键与 .env 对齐（DEEPSEEK_API_KEY / DEFAULT_MODEL / API_HOST / MCP_HOST 已补齐）；
# 生产部署必须覆盖 ADMIN_TOKEN / JWT_SECRET 等安全默认值。

# DashScope API Key（通义千问 LLM + embedding）
# 启动校验需要占位 Key（如 "sk-placeholder"），LLM 调用需真实 Key
DASHSCOPE_API_KEY=sk-placeholder

# DeepSeek API Key（备用 LLM，可选；留空则仅用 DashScope）
DEEPSEEK_API_KEY=sk-placeholder

# 默认模型（DashScope 通义千问系列，如 qwen-plus / qwen-max）
DEFAULT_MODEL=qwen-plus

# 服务端口与监听地址
API_PORT=9900
API_HOST=0.0.0.0
MCP_PORT=9901
MCP_HOST=0.0.0.0

# 数据库路径（SQLite）
DATABASE_PATH=data/gridmind.db

# Chroma 持久化路径（留空则使用内存模式）
CHROMA_PERSIST_DIR=data/chroma_db

# Log 级别
LOG_LEVEL=INFO

# 是否启用 Mock 工具（演示时关闭）
MOCK_ENABLED=false

# 图谱持久化路径（SQLite，留空则内存态）
GRAPH_DB_PATH=data/graph.db

# ---- V1.5.1 T06 安全默认值（生产必须覆盖，api/config.py 有兜底默认值）----
# 灰度管理 admin token
ADMIN_TOKEN=change-me-admin-token
# JWT 签名密钥（生产必须设置为随机长字符串）
JWT_SECRET=change-me-jwt-secret
# JWT 签名算法（默认 HS256）
JWT_ALGORITHM=HS256
# JWT 签发方（issuer claim）
JWT_ISSUER=gridmind

# ---- Neo4j（docker compose 一体化编排时由容器注入；独立部署时按需填写）----
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=gridmind-dev
NEO4J_DATABASE=neo4j
